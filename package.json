{
  "name": "court-analyzer",
  "productName": "CourtAnalyzer",
  "version": "1.0.0",
  "description": "Аналіз і систематизація судових рішень з ЄДРСР за допомогою ШІ",
  "author": "Lexcovery",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev:ui": "vite",
    "build:ui": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/run-tests.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "start": "tauri dev",
    "dist": "tauri build --no-bundle && node scripts/collect-release.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "@tauri-apps/cli": "^2.12.4"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2"
  }
}
