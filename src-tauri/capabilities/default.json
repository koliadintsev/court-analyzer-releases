{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Дозволи головного вікна",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**" }]
    },
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }, { "url": "http://*:*" }]
    }
  ]
}
